# ============================================================================
# Telegram Harness Manager - Configuration Template (.env.example)
# Copy this file to `.env` for local configuration.
# NEVER commit your real `.env` file to version control!
# ============================================================================

# --- MODE 1: Official Cloud Bridge Mode (Recommended for End Users) ---
# Connect to the official Telegram Serverless backend without needing a Bot Token.
# Run `telegram-harness-manager pair` to generate your personal `THM_DEVICE_TOKEN`.
THM_MODE=cloud
THM_CLOUD_URL=https://appYOUR_TGCLOUD_APP_ID.tgcloud.ai
THM_DEVICE_TOKEN=YOUR_PERSONAL_DEVICE_TOKEN_FROM_PAIRING

# --- MODE 2: Self-Hosted / Bot Owner Mode (Bring Your Own Bot) ---
# Only fill these if you are hosting your own Telegram Bot instance or deploying
# to your own Telegram Serverless (`tgcloud`) account.
TELEGRAM_BOT_NAME=@Your_Harness_Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Optional: Mini App URL (hosted on Telegram Serverless `https://app<id>.tgcloud.ai` or GitHub Pages)
THM_WEBAPP_URL=https://rubensrainelli.github.io/telegram-harness-manager/

# Local Companion HTTP Port (for Hooks, MCP & Local WebApp preview)
THM_LOCAL_PORT=8430

# Default Language Fallback (en | it) - Auto-detected per user from Telegram `language_code`
THM_DEFAULT_LOCALE=en
